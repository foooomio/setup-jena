{
  "name": "setup-jena",
  "version": "4.0.0",
  "description": "GitHub Action to setup Apache Jena",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/setup-jena.ts --outfile=dist/index.js --bundle --platform=node --target=node24",
    "type-check": "tsc",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "uvu -r tsm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foooomio/setup-jena.git"
  },
  "author": "foooomio",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/foooomio/setup-jena/issues"
  },
  "homepage": "https://github.com/foooomio/setup-jena#readme",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.27.3",
    "prettier": "^3.8.1",
    "tsm": "^2.3.0",
    "typescript": "^5.9.3",
    "uvu": "^0.5.6"
  },
  "engines": {
    "node": "24",
    "pnpm": "10"
  }
}
